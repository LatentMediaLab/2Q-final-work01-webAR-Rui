{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fuv-collection",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-08-29",
  "exports": {
    "OAuthTokenDurableObject": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "env": {
    "staging": {
      "name": "fuv-collection-staging",
      "vars": {
        "POSTS_COORDINATOR_NAME": "SET_A_STABLE_COORDINATOR_NAME"
      },
      "secrets": {
        "required": ["X_OAUTH_CLIENT_ID", "X_OAUTH_CLIENT_SECRET"]
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "OAUTH_TOKEN_COORDINATOR",
            "class_name": "OAuthTokenDurableObject"
          }
        ]
      },
      "kv_namespaces": [
        {
          "binding": "POSTS_STORE",
          "id": "STAGING_KV_NAMESPACE_ID"
        }
      ]
    },
    "production": {
      "name": "fuv-collection",
      "vars": {
        "POSTS_COORDINATOR_NAME": "SET_A_STABLE_COORDINATOR_NAME"
      },
      "secrets": {
        "required": ["X_OAUTH_CLIENT_ID", "X_OAUTH_CLIENT_SECRET"]
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "OAUTH_TOKEN_COORDINATOR",
            "class_name": "OAuthTokenDurableObject"
          }
        ]
      },
      "kv_namespaces": [
        {
          "binding": "POSTS_STORE",
          "id": "PRODUCTION_KV_NAMESPACE_ID"
        }
      ]
    }
  }
}
